@page
@model ChenWebSite.Pages.ServiceModel
@{
    ViewData["Title"] = "Service";
}

<!-- Page Header Start -->
<div class="container-fluid page-header">
    <h1 class="display-3 text-uppercase text-white mb-3">Service</h1>
    <div class="d-inline-flex text-white">
        <h6 class="text-uppercase m-0"><a asp-page="/Index" class="back-to-home">Home</a></h6>
        <h6 class="text-white m-0 px-3">/</h6>
        <h6 class="text-uppercase text-white m-0">Service</h6>
    </div>
</div>
<!-- Page Header Start -->
<!-- Services Start -->
<div class="container-fluid bg-light py-6 px-5">
    <div class="text-center mx-auto mb-5" style="max-width: 600px;">
        <h1 class="display-5 text-uppercase mb-4">We Provide <span class="text-primary">The Best</span> Services</h1>
    </div>
    <div class="row g-5">
        <div class="col-lg-4 col-md-6">
            <div class="service-item bg-white rounded d-flex flex-column align-items-center text-center">
                <img class="img-fluid" src="img/architectural-design.jpg" alt="">
                <div class="service-icon bg-white">
                    <i class="fa fa-3x fa-drafting-compass text-primary"></i>
                </div>
                <div class="px-4 pb-4">
                    <h4 class="text-uppercase mb-3">Architecture Design</h4>
                    <p>We prepare architectural drawings including floor plans, elevations, sections, 3D views and building approval drawings.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="service-item bg-white rounded d-flex flex-column align-items-center text-center">
                <img class="img-fluid" src="img/structural-design.jpg" alt="">
                <div class="service-icon bg-white">
                    <i class="fa fa-3x fa-building text-primary"></i>
                </div>
                <div class="px-4 pb-4">
                    <h4 class="text-uppercase mb-3">Structural Design</h4>
                    <p>We design structural drawings including foundations, columns, beams, slabs and reinforcement detailing to ensure structural safety and stability.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="service-item bg-white d-flex flex-column align-items-center text-center">
                <img class="img-fluid" src="img/construction.jpg" alt="">
                <div class="service-icon bg-white">
                    <i class="fa fa-3x fa-hard-hat text-primary"></i>
                </div>
                <div class="px-4 pb-4">
                    <h4 class="text-uppercase mb-3">Construction</h4>
                    <p>We provide full construction services including project supervision, building construction, renovations and site management.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="service-item bg-white rounded d-flex flex-column align-items-center text-center">
                <img class="img-fluid" src="img/interior-design.jpg" alt="">
                <div class="service-icon bg-white">
                    <i class="fa fa-3x fa-couch text-primary"></i>
                </div>
                <div class="px-4 pb-4">
                    <h4 class="text-uppercase mb-3">Interior Design</h4>
                    <p>We design interior spaces including ceilings, lighting, finishes, furniture layout and space planning.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="service-item bg-white rounded d-flex flex-column align-items-center text-center">
                <img class="img-fluid" src="img/land-scaping.jpg" alt="">
                <div class="service-icon bg-white">
                    <i class="fa fa-3x fa-leaf text-primary"></i>
                </div>
                <div class="px-4 pb-4">
                    <h4 class="text-uppercase mb-3">Landscaping</h4>
                    <p>We design and construct outdoor spaces including compound layout, paving, gardens, drainage and boundary walls.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Services End -->