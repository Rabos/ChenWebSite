@foreach (var item in shuffledItems)
{
    <div class="col-xl-4 col-lg-4 col-md-4 portfolio-item @item.Category">
        <div class="position-relative portfolio-box">
            <img class="img-fluid w-100" src="@item.Image" alt="">
            @if (!string.IsNullOrEmpty(item.Title))
            {
                <div class="portfolio-title shadow-sm">
                    <p class="h4 text-uppercase">@item.Title</p>
                    @if (!string.IsNullOrEmpty(item.Location))
                    {
                        <span class="text-body"><i class="fa fa-map-marker-alt text-primary me-2"></i>@item.Location</span>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(item.Image))
            {
                <a class="portfolio-btn" href="@item.Image" data-lightbox="portfolio">
                    <i class="bi bi-plus text-white"></i>
                </a>
            }
        </div>
    </div>
}