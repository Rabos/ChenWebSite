@page
@model ChenWebSite.Pages.AboutModel
@{
    ViewData["Title"] = "About";
}

<!-- Page Header Start -->
<div class="container-fluid page-header">
    <h1 class="display-3 text-uppercase text-white mb-3">About</h1>
    <div class="d-inline-flex text-white">
        <h6 class="text-uppercase m-0"><a asp-page="/Index" class="back-to-home">Home</a></h6>
        <h6 class="text-white m-0 px-3">/</h6>
        <h6 class="text-uppercase text-white m-0">About</h6>
    </div>
</div>
<!-- Page Header Start -->
<!-- About Start -->
<div class="container-fluid py-6 px-5">
    <div class="row g-5 justify-content-center">
        <div class="col-lg-12">
            <h1 class="text-uppercase mb-4">We <span class="text-primary">Design</span>. We <span class="text-primary">Build</span>. We <span class="text-primary">Deliver Quality</span>.</h1>
            <p><b>Chen Structure Hub</b> is a professional architectural design, structural engineering and construction company providing modern, safe and cost-effective building solutions. We specialize in residential, commercial and institutional projects from concept design to project completion.</p>
            <div class="row gx-5 py-2">
                <div class="col-sm-6 mb-2">
                    <p class="fw-bold mb-2"><i class="fa fa-check text-primary me-3"></i>Professionalism</p>
                    <p class="fw-bold mb-2"><i class="fa fa-check text-primary me-3"></i>Quality workmanship</p>
                    <p class="fw-bold mb-2"><i class="fa fa-check text-primary me-3"></i>Integrity</p>
                </div>
                <div class="col-sm-6 mb-2">
                    <p class="fw-bold mb-2"><i class="fa fa-check text-primary me-3"></i>Innovation</p>
                    <p class="fw-bold mb-2"><i class="fa fa-check text-primary me-3"></i>Client satisfaction</p>
                    <p class="fw-bold mb-2"><i class="fa fa-check text-primary me-3"></i>Safety </p>
                </div>
            </div>
            <p class="mb-4">We turn ideas into strong, functional and beautiful structures through proper planning, engineering design and quality construction.</p>

        </div>
    </div>
</div>
<!-- About End -->